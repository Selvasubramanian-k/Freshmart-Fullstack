# Copy this file to .env and change values
MONGO_URI=mongodb://localhost:27017
DB_NAME=freshmart
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLATFORM_COMMISSION_PERCENT=10

# Mobile OTP login
# true = the OTP shows on screen (local / demo only). Keep false for a real store.
OTP_DEV_MODE=true
# Real SMS (India): SMS_PROVIDER=msg91 + SMS_API_KEY + SMS_TEMPLATE_ID (DLT approved)
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE_ID=

# FreshMart owner (super admin): your mobile number(s), comma separated.
# Log in with this number -> the owner panel opens (all stores, commission, areas, offers, users, support team).
SUPER_ADMIN_PHONES=
